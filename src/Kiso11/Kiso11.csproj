<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\kiso11.ico</ApplicationIcon>
    <Title>Kiso11</Title>
    <Product>Kiso11 - Windows 11 ISO Debloater &amp; Bootable USB Creator</Product>
    <Description>Fast, clean and modern Windows 11 ISO optimizer, debloater, and bootable media creator.</Description>
    <Version>1.0.0</Version>
    <Authors>Kiso11 Team</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\kiso11-logo.png" />
    <Resource Include="Assets\kiso11.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

</Project>
