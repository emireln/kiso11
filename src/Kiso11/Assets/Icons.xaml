<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Windows system icon font (Segoe MDL2 Assets). Each value is one glyph; the font family is IconFontFamily. -->
    <sys:String x:Key="IconUpload">&#xE898;</sys:String>
    <sys:String x:Key="IconDisc">&#xE958;</sys:String>
    <sys:String x:Key="IconUsb">&#xE88E;</sys:String>
    <sys:String x:Key="IconCheck">&#xE73E;</sys:String>
    <sys:String x:Key="IconClose">&#xE711;</sys:String>
    <sys:String x:Key="IconCopy">&#xE8C8;</sys:String>
    <sys:String x:Key="IconDelete">&#xE74D;</sys:String>
    <sys:String x:Key="IconRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="IconBack">&#xE72B;</sys:String>
    <sys:String x:Key="IconMinimize">&#xE921;</sys:String>
    <sys:String x:Key="IconChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="IconWarning">&#xE7BA;</sys:String>
    <sys:String x:Key="IconOpenExternal">&#xE8A7;</sys:String>
    <sys:String x:Key="IconFile">&#xE7C3;</sys:String>

</ResourceDictionary>
