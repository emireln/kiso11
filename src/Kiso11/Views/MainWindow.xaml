<Window x:Class="Kiso11.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kiso11.ViewModels"
        xmlns:conv="clr-namespace:Kiso11.Converters"
        Title="{Binding Loc.WindowTitle}"
        Icon="/Assets/kiso11-logo.png"
        Width="880"
        Height="640"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
        <conv:StepPastConverter x:Key="StepDoneToVis" />
        <conv:StepPastConverter x:Key="StepPendingToVis" Inverse="True" />

        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,4,16,10" />
        </Style>

        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PageHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInspectionError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/kiso11-logo.png"
                           Width="22"
                           Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Kiso11"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0"
                                Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc.AdminStatus}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding RestartAsAdminCommand}"
                            Margin="0,0,12,0"
                            Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource IconWarning}"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Loc.RestartAsAdmin}"
                                       FontSize="12"
                                       Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Background="{StaticResource InputBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}"
                                         GroupName="AppLang"
                                         Content="PT"
                                         IsChecked="{Binding IsPtBrSelected, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}"
                                         GroupName="AppLang"
                                         Content="EN"
                                         IsChecked="{Binding IsEnSelected, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding MinimizeToTrayCommand}"
                            ToolTip="{Binding Loc.MinimizeToTray}"
                            Content="{Binding Loc.TrayButton}"
                            FontSize="12"
                            Margin="0,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- STEPPER -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <UniformGrid Columns="4" Height="48">
                <RadioButton Style="{StaticResource StepperTabStyle}"
                             GroupName="StepperWorkflow"
                             IsChecked="{Binding IsStep1, Mode=OneWay}"
                             Command="{Binding GoToStepCommand}"
                             CommandParameter="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1" Margin="0,0,10,0"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                            <Grid>
                                <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Visibility="{Binding CurrentStep, Converter={StaticResource StepPendingToVis}, ConverterParameter=1}" />
                                <TextBlock Text="{StaticResource IconCheck}" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding CurrentStep, Converter={StaticResource StepDoneToVis}, ConverterParameter=1}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Loc.Step1Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource StepperTabStyle}"
                             GroupName="StepperWorkflow"
                             IsChecked="{Binding IsStep2, Mode=OneWay}"
                             Command="{Binding GoToStepCommand}"
                             CommandParameter="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1" Margin="0,0,10,0"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                            <Grid>
                                <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Visibility="{Binding CurrentStep, Converter={StaticResource StepPendingToVis}, ConverterParameter=2}" />
                                <TextBlock Text="{StaticResource IconCheck}" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding CurrentStep, Converter={StaticResource StepDoneToVis}, ConverterParameter=2}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Loc.Step2Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource StepperTabStyle}"
                             GroupName="StepperWorkflow"
                             IsChecked="{Binding IsStep3, Mode=OneWay}"
                             Command="{Binding GoToStepCommand}"
                             CommandParameter="3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1" Margin="0,0,10,0"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                            <Grid>
                                <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Visibility="{Binding CurrentStep, Converter={StaticResource StepPendingToVis}, ConverterParameter=3}" />
                                <TextBlock Text="{StaticResource IconCheck}" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding CurrentStep, Converter={StaticResource StepDoneToVis}, ConverterParameter=3}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Loc.Step3Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource StepperTabStyle}"
                             GroupName="StepperWorkflow"
                             IsChecked="{Binding IsStep4, Mode=OneWay}"
                             Command="{Binding GoToStepCommand}"
                             CommandParameter="4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1" Margin="0,0,10,0"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                            <Grid>
                                <TextBlock Text="4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           Visibility="{Binding CurrentStep, Converter={StaticResource StepPendingToVis}, ConverterParameter=4}" />
                                <TextBlock Text="{StaticResource IconCheck}" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding CurrentStep, Converter={StaticResource StepDoneToVis}, ConverterParameter=4}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Loc.Step4Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="2" Margin="24,20,24,16">

            <!-- STEP 1: SOURCE ISO -->
            <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding Loc.Step1Heading}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Loc.Step1Hint}" Style="{StaticResource PageHint}" />
                </StackPanel>

                <!-- Empty state: drop zone -->
                <Grid Grid.Row="1" Visibility="{Binding HasIsoSelected, Converter={StaticResource InverseBoolToVis}}">
                    <Rectangle RadiusX="10"
                               RadiusY="10"
                               Fill="{StaticResource CardBrush}"
                               Stroke="{StaticResource BorderHighlightBrush}"
                               StrokeThickness="1"
                               StrokeDashArray="5 4" />

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{StaticResource IconUpload}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="26"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Loc.DropTitle}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Loc.DropOr}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,14" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseIsoCommand}"
                                Content="{Binding Loc.BrowseIso}"
                                HorizontalAlignment="Center"
                                Padding="18,0" />
                    </StackPanel>
                </Grid>

                <!-- Loaded state: file card -->
                <Border Grid.Row="1"
                        Style="{StaticResource GroupCard}"
                        Padding="20"
                        VerticalAlignment="Top"
                        Visibility="{Binding HasIsoSelected, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{StaticResource IconFile}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="24"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,2,18,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding IsoFileName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding IsoPath}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding IsoSizeText}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="·"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="8,0"
                                           Visibility="{Binding IsIsoValid, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Loc.IsoValid}"
                                           FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Visibility="{Binding IsIsoValid, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Border Style="{StaticResource RowDivider}" Margin="0,16" />

                            <TextBlock Text="{Binding Loc.EditionLabel}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Editions}"
                                      SelectedItem="{Binding SelectedEdition}"
                                      DisplayMemberPath="Name"
                                      Width="320"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding IsIsoValid, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding InspectionMessage}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,10,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseIsoCommand}"
                                Content="{Binding Loc.ChangeIso}"
                                VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </Grid>

            <!-- STEP 2: OUTPUT -->
            <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding Loc.Step2Heading}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Loc.Step2Hint}" Style="{StaticResource PageHint}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0"
                                 Style="{StaticResource TargetOptionCardStyle}"
                                 GroupName="TargetSelectionMode"
                                 IsChecked="{Binding IsIsoOutputMode, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.TargetIsoTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Loc.TargetIsoDesc}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Column="2"
                                 Style="{StaticResource TargetOptionCardStyle}"
                                 GroupName="TargetSelectionMode"
                                 IsChecked="{Binding IsUsbOutputMode, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.TargetUsbTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Loc.TargetUsbDesc}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource GroupCard}"
                        Padding="20"
                        VerticalAlignment="Top">
                    <Grid>
                        <!-- ISO file path -->
                        <StackPanel Visibility="{Binding IsIsoOutputMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Loc.SaveTo}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding OutputIsoPath, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseOutputIsoCommand}"
                                        Content="{Binding Loc.Browse}"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <!-- USB drive -->
                        <StackPanel Visibility="{Binding IsUsbOutputMode, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Loc.Drive}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding RefreshUsbDrivesCommand}"
                                        Content="{Binding Loc.Refresh}"
                                        Padding="8,0"
                                        MinHeight="28" />
                            </Grid>

                            <ComboBox ItemsSource="{Binding UsbDrives}"
                                      SelectedItem="{Binding SelectedUsbDrive}"
                                      DisplayMemberPath="DisplayName">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="IsEnabled" Value="{Binding IsSupported}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock Text="{Binding Loc.UsbEraseWarning}"
                                       FontSize="12"
                                       Foreground="{StaticResource WarningBrush}"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding HasUsbDrives, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding Loc.NoUsbDrives}"
                                       Style="{StaticResource MutedText}"
                                       Visibility="{Binding HasUsbDrives, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- STEP 3: OPTIONS -->
            <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Loc.Step3Heading}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Loc.Step3Hint}" Style="{StaticResource PageHint}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SelectPresetRecommendedCommand}"
                            Content="{Binding Loc.Recommended}"
                            VerticalAlignment="Bottom" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Remove -->
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.GroupRemove}" Style="{StaticResource GroupTitle}" />
                            <CheckBox Style="{StaticResource SettingToggleStyle}"
                                      Content="{Binding Loc.OptBloatware}"
                                      ToolTip="{Binding Loc.TipBloatware}"
                                      IsChecked="{Binding DebloatOptions.RemoveBloatware}" />
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox Style="{StaticResource SettingToggleStyle}"
                                      Content="{Binding Loc.OptAiCopilot}"
                                      ToolTip="{Binding Loc.TipAiCopilot}"
                                      IsChecked="{Binding DebloatOptions.RemoveAiAndCopilot}" />
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox Style="{StaticResource SettingToggleStyle}"
                                      Content="{Binding Loc.OptOneDrive}"
                                      ToolTip="{Binding Loc.TipOneDrive}"
                                      IsChecked="{Binding DebloatOptions.RemoveOneDrive}" />
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox Style="{StaticResource SettingToggleStyle}"
                                      Content="{Binding Loc.OptEdge}"
                                      ToolTip="{Binding Loc.TipEdge}"
                                      IsChecked="{Binding DebloatOptions.RemoveEdge}" />
                        </StackPanel>
                    </Border>

                    <!-- System -->
                    <Border Grid.Column="2" Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.GroupSystem}" Style="{StaticResource GroupTitle}" />
                            <CheckBox Style="{StaticResource SettingToggleStyle}"
                                      Content="{Binding Loc.OptBitlocker}"
                                      ToolTip="{Binding Loc.TipBitlocker}"
                                      IsChecked="{Binding DebloatOptions.DisableBitlocker}" />
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox Style="{StaticResource SettingToggleStyle}"
                                      Content="{Binding Loc.OptTelemetry}"
                                      ToolTip="{Binding Loc.TipTelemetry}"
                                      IsChecked="{Binding DebloatOptions.DisableTelemetry}" />
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox Style="{StaticResource SettingToggleStyle}"
                                      Content="{Binding Loc.OptUserFolders}"
                                      ToolTip="{Binding Loc.TipUserFolders}"
                                      IsChecked="{Binding DebloatOptions.RestoreClassicFolders}" />
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox Style="{StaticResource SettingToggleStyle}"
                                      Content="{Binding Loc.OptMsa}"
                                      ToolTip="{Binding Loc.TipMsa}"
                                      IsChecked="{Binding DebloatOptions.BypassMicrosoftAccount}" />
                            <Border Style="{StaticResource RowDivider}" />
                            <CheckBox Style="{StaticResource SettingToggleStyle}"
                                      Content="{Binding Loc.OptHardware}"
                                      ToolTip="{Binding Loc.TipHardware}"
                                      IsChecked="{Binding DebloatOptions.BypassHardwareChecks}" />
                        </StackPanel>
                    </Border>

                    <!-- Advanced -->
                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.GroupAdvanced}" Style="{StaticResource GroupTitle}" />
                            <UniformGrid Columns="2">
                                <CheckBox Style="{StaticResource SettingToggleStyle}"
                                          Content="{Binding Loc.OptDrivers}"
                                          ToolTip="{Binding Loc.TipDrivers}"
                                          IsChecked="{Binding DebloatOptions.IntegrateIntelRstDrivers}"
                                          Margin="0,0,16,0" />
                                <CheckBox Style="{StaticResource SettingToggleStyle}"
                                          Content="{Binding Loc.OptEsd}"
                                          ToolTip="{Binding Loc.TipEsd}"
                                          IsChecked="{Binding DebloatOptions.ConvertToEsd}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- STEP 4: BUILD -->
            <Grid Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding CurrentStageText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressPercentage, StringFormat={}{0}%}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ProgressBar Grid.Row="1"
                             Value="{Binding ProgressPercentage}"
                             Margin="0,0,0,12" />

                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc.Elapsed}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ElapsedTimeFormatted}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,16,0" />
                        <TextBlock Text="{Binding Loc.Remaining}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding RemainingTimeFormatted}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Log -->
                <Border Grid.Row="3"
                        Background="{StaticResource TerminalBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,4,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Loc.ConsoleTitle}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding CopyLogCommand}"
                                        ToolTip="{Binding Loc.CopyLog}"
                                        Content="{StaticResource IconCopy}" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ClearLogCommand}"
                                        ToolTip="{Binding Loc.ClearLog}"
                                        Content="{StaticResource IconDelete}"
                                        Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer x:Name="LogScroller"
                                      Grid.Row="1"
                                      Padding="14,4,14,12"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Logs}"
                                       FontFamily="{StaticResource CodeFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource TerminalTextBrush}"
                                       TextWrapping="NoWrap"
                                       LineHeight="18" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid Height="68">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding PreviousStepCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconBack}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Loc.Back}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DangerGhostButtonStyle}"
                            Command="{Binding CancelProcessCommand}"
                            Content="{Binding Loc.Cancel}"
                            Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVis}}" />

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NextStepCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Content="{Binding Loc.Continue}"
                            MinWidth="132"
                            Visibility="{Binding ShowNextButton, Converter={StaticResource BoolToVis}}" />

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NextStepCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Content="{Binding Loc.Start}"
                            MinWidth="132"
                            Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}" />

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartNewDebloatCommand}"
                            Content="{Binding Loc.NewRun}"
                            MinWidth="132"
                            Visibility="{Binding ShowNewRunButton, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
