<Window x:Class="Kiso11.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Kiso11.ViewModels"
        xmlns:conv="clr-namespace:Kiso11.Converters"
        Title="Kiso11" Icon="/Assets/kiso11.ico" Width="1080" Height="760" MinWidth="900" MinHeight="650"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" AllowDrop="True"
        DragOver="OnWindowDragOver" Drop="OnWindowDrop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <!-- Custom caption bar with native window resize and snap behavior. -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="/Assets/kiso11-logo.png" Width="22" Height="22" Margin="0,0,9,0" />
                    <TextBlock Text="Kiso11" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#EFF3F7" CornerRadius="4" Padding="7,3" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Loc.TitleBarSubtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding MinimizeToTrayCommand}" Content="{Binding Loc.TrayMinimize}"
                            MinHeight="30" Padding="10,0" FontSize="11" Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Border Background="#F4F6F8" CornerRadius="5" Padding="2" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="PT" GroupName="AppLang" Padding="9,5" FontSize="12"
                                         IsChecked="{Binding IsPtBrSelected, Mode=TwoWay}" />
                            <RadioButton Content="EN" GroupName="AppLang" Padding="9,5" FontSize="12"
                                         IsChecked="{Binding IsEnSelected, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource WindowButtonStyle}" Content="—" ToolTip="Minimize" Click="MinimizeWindow"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource WindowButtonStyle}" Content="□" ToolTip="Maximize" Click="ToggleMaximizeWindow"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CloseWindowButtonStyle}" Content="×" ToolTip="{Binding Loc.CloseWindowTooltip}" Click="CloseWindow"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workflow navigation and working area. -->
        <Grid Grid.Row="1" Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="5,4,5,0">
                        <TextBlock Text="{Binding Loc.WorkflowTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Loc.Step1Title}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource StepNavButtonStyle}" Command="{Binding GoToStepCommand}" CommandParameter="1">
                            <Border CornerRadius="6" Padding="8,7">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsStep1}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="01" Width="34" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.Step1Title}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource StepNavButtonStyle}" Command="{Binding GoToStepCommand}" CommandParameter="2">
                            <Border CornerRadius="6" Padding="8,7">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsStep2}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="02" Width="34" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.Step2Title}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource StepNavButtonStyle}" Command="{Binding GoToStepCommand}" CommandParameter="3">
                            <Border CornerRadius="6" Padding="8,7">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="03" Width="34" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.Step3Title}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="10,12" />
                        <Border CornerRadius="6" Padding="8,7">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsStep4}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="04" Width="34" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Loc.Step4Title}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="4" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.MetricStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding StateText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding IsoFileName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="2,0,0,0">
                    <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Loc.PageSourceTitle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True"><Setter Property="Text" Value="{Binding Loc.PageCustomizeTitle}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="Text" Value="{Binding Loc.PageOutputTitle}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsStep4}" Value="True"><Setter Property="Text" Value="{Binding Loc.PageProgressTitle}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Loc.PageSourceSubtitle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True"><Setter Property="Text" Value="{Binding Loc.PageCustomizeSubtitle}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="Text" Value="{Binding Loc.PageOutputSubtitle}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsStep4}" Value="True"><Setter Property="Text" Value="{Binding Loc.PageProgressSubtitle}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Step 1: source ISO and an explicit edition selection. -->
                <Grid Grid.Row="2" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc.DropIsoHere}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Loc.SupportedMediaNote}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,16" />
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BrowseIsoCommand}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Loc.SelectIsoAction}" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0"
                                        Visibility="{Binding HasIsoSelected, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding IsoFileName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding IsoSizeText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding InspectIsoCommand}"
                                                MinWidth="180" Margin="16,0,0,0">
                                            <TextBlock Text="{Binding Loc.InspectIso}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding IsoStatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,12,2,0" />
                                <TextBlock Text="{Binding Loc.ChooseEdition}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="2,18,0,7"
                                           Visibility="{Binding IsIsoInspected, Converter={StaticResource BoolToVis}}" />
                                <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding AvailableEditions}" SelectedItem="{Binding SelectedEdition}"
                                          DisplayMemberPath="DisplayName" Visibility="{Binding IsIsoInspected, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Loc.EditionOnlyNote}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="2,7,0,0"
                                           Visibility="{Binding IsIsoInspected, Converter={StaticResource BoolToVis}}" />

                                <Border Background="#FFF7E8" BorderBrush="#F3D7A1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,18,0,0"
                                        Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc.AdministratorAccessNote}" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RestartAsAdminCommand}" Content="{Binding Loc.RestartAsAdmin}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Step 2: clearly described choices; no decorative icon grid. -->
                <Grid Grid.Row="2" Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="#C5DDF1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc.PresetRecommended}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Loc.RecommendedPresetDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,16,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectPresetRecommendedCommand}" Content="{Binding Loc.ApplyPreset}" MinWidth="128" />
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
                                    <UniformGrid Columns="2">
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptBloatware}" IsChecked="{Binding DebloatOptions.RemoveBloatware}" /><TextBlock Text="{Binding Loc.BloatwareDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptAiCopilot}" IsChecked="{Binding DebloatOptions.RemoveAiAndCopilot}" /><TextBlock Text="{Binding Loc.AiDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptOneDrive}" IsChecked="{Binding DebloatOptions.RemoveOneDrive}" /><TextBlock Text="{Binding Loc.OneDriveDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptEdge}" IsChecked="{Binding DebloatOptions.RemoveEdge}" /><TextBlock Text="{Binding Loc.EdgeDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptHardware}" IsChecked="{Binding DebloatOptions.BypassHardwareChecks}" /><TextBlock Text="{Binding Loc.HardwareDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptMsa}" IsChecked="{Binding DebloatOptions.BypassMicrosoftAccount}" /><TextBlock Text="{Binding Loc.MsaDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptBitlocker}" IsChecked="{Binding DebloatOptions.DisableBitlocker}" /><TextBlock Text="{Binding Loc.BitlockerDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptTelemetry}" IsChecked="{Binding DebloatOptions.DisableTelemetry}" /><TextBlock Text="{Binding Loc.TelemetryDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptUserFolders}" IsChecked="{Binding DebloatOptions.RestoreUserFolders}" /><TextBlock Text="{Binding Loc.UserFoldersDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptDrivers}" IsChecked="{Binding DebloatOptions.IntegrateIntelDrivers}" /><TextBlock Text="{Binding Loc.DriversDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                            <StackPanel><CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{Binding Loc.OptEsd}" IsChecked="{Binding DebloatOptions.CompressEsd}" /><TextBlock Text="{Binding Loc.EsdDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,7,2,0" /></StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Step 3: destination choice and a plain summary. -->
                <Grid Grid.Row="2" Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc.TargetIsoTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <RadioButton Content="{Binding Loc.RadioIso}" IsChecked="{Binding IsIsoOutputMode, Mode=TwoWay}" GroupName="OutputMode" Margin="0,16,0,0" FontSize="14" />
                                    <TextBlock Text="{Binding Loc.TargetIsoDesc}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="23,4,0,0" TextWrapping="Wrap" />
                                    <Grid Margin="23,10,0,0" Visibility="{Binding IsIsoOutputMode, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding OutputIsoPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseOutputIsoCommand}" Content="{Binding Loc.BrowsePath}" Margin="8,0,0,0" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18" />
                                    <RadioButton Content="{Binding Loc.RadioUsb}" IsChecked="{Binding IsUsbOutputMode, Mode=TwoWay}" GroupName="OutputMode" FontSize="14" />
                                    <TextBlock Text="{Binding Loc.TargetUsbDesc}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="23,4,0,0" TextWrapping="Wrap" />
                                    <StackPanel Margin="23,10,0,0" Visibility="{Binding IsUsbOutputMode, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Loc.SelectUsbDriveTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshUsbDrivesCommand}" Content="{Binding Loc.RefreshDrives}" MinHeight="36" />
                                        </Grid>
                                        <ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding UsbDrives}" SelectedItem="{Binding SelectedUsbDrive}" DisplayMemberPath="DisplayName" />
                                        <TextBlock Text="{Binding Loc.NoUsbDrives}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,7,0,0"
                                                   Visibility="{Binding HasUsbDrives, Converter={StaticResource InverseBoolToVis}}" />
                                        <TextBlock Text="{Binding Loc.UsbWarning}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc.ChooseEdition}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedEdition.DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Step 4: useful status first; logs remain available below. -->
                <Grid Grid.Row="2" Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentStageText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat={}{0}%}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <ProgressBar Style="{StaticResource ProgressBarStyle}" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Margin="0,15,0,0" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Loc.MetricElapsed}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding ElapsedTimeFormatted}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Loc.MetricEstimated}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding RemainingTimeFormatted}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Loc.LogTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CopyLogCommand}" Content="{Binding Loc.CopyText}" MinHeight="32" Padding="12,0" Margin="6,0,0,0" />
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearLogCommand}" Content="{Binding Loc.ClearText}" MinHeight="32" Padding="12,0" Margin="6,0,0,0" />
                            </Grid>
                            <TextBox Grid.Row="1" Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     Background="#F8F9FB" Foreground="#35404B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10"
                                     TextChanged="OnLogTextChanged" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Consistent navigation actions with one primary action per screen. -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Loc.AdminActive}" FontSize="12" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"
                           Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviousStepCommand}" Content="{Binding Loc.Back}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NextStepCommand}" Content="{Binding Loc.Next}"
                            IsEnabled="{Binding CanGoNext}" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}" MinWidth="150" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NextStepCommand}" Content="{Binding Loc.Next}"
                            IsEnabled="{Binding CanGoNext}" Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}" MinWidth="150" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartProcessCommand}" Content="{Binding Loc.StartDebloat}"
                            IsEnabled="{Binding CanGoNext}" Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}" MinWidth="190" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelProcessCommand}" Content="{Binding Loc.CancelOperation}"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" MinWidth="160" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartNewDebloatCommand}" Content="{Binding Loc.StartNew}"
                            Visibility="{Binding IsProcessing, Converter={StaticResource InverseBoolToVis}}" MinWidth="170" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
