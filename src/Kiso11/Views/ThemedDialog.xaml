<Window x:Class="Kiso11.Views.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiso11"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnCardMouseDown">

    <!-- The margin leaves room for the shadow. -->
    <Border x:Name="Card"
            Margin="16"
            Padding="24,22,24,20"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderHighlightBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,8,0,0" />

            <StackPanel x:Name="ButtonPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0" />
        </StackPanel>
    </Border>
</Window>
